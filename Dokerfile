FROM python:3.10-slim

# نصب جاوا و ابزارهای لازم
RUN apt-get update && apt-get install -y \
    openjdk-17-jdk \
    wget \
    unzip \
    curl \
    && rm -rf /var/lib/apt/lists/*

# نصب Android SDK Build-Tools (برای zipalign و apksigner)
RUN wget https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip -O /tmp/sdk.zip && \
    unzip /tmp/sdk.zip -d /opt/android-sdk/ && \
    mkdir -p /opt/android-sdk/cmdline-tools/latest && \
    mv /opt/android-sdk/cmdline-tools/* /opt/android-sdk/cmdline-tools/latest/ 2>/dev/null || true && \
    echo "y" | /opt/android-sdk/cmdline-tools/latest/bin/sdkmanager "build-tools;34.0.0" && \
    ln -s /opt/android-sdk/build-tools/34.0.0/zipalign /usr/local/bin/zipalign && \
    ln -s /opt/android-sdk/build-tools/34.0.0/apksigner /usr/local/bin/apksigner && \
    ln -s /opt/android-sdk/build-tools/34.0.0/aapt2 /usr/local/bin/aapt2

# نصب Apktool
RUN wget https://github.com/iBotPeaches/Apktool/releases/download/v2.9.3/apktool_2.9.3.jar -O /usr/local/bin/apktool.jar && \
    echo '#!/bin/sh' > /usr/local/bin/apktool && \
    echo 'exec java -jar /usr/local/bin/apktool.jar "$@"' >> /usr/local/bin/apktool && \
    chmod +x /usr/local/bin/apktool

WORKDIR /app
COPY . /app

RUN pip install --no-cache-dir -r requirements.txt

CMD ["python", "app.py"]
